	<group name="first-time-common-edition" excludeByPolicy="first-time-common-exclude,stated-relationship,first-time-release-text-exclude" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation" />
	<group name="LoincEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,LOINC" />
	<group name="GPFP-ICPC2" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,GPFP-ICPC2" />
	<group name="GMDN" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,GMDN" />

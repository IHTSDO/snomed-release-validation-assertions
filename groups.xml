<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	assertionGroupingStrategy (groups.xml)

	Purpose: defines how assertions are assigned to named assertion groups when the
	Release Validation Framework imports assertion groups. Policy definitions live in
	policies.xml; this file lists group membership rules only.

	group (one row per assertion group name)
	- name: group identifier; required and must be non-blank.

	Matching order for an assertion against a group (all steps use this group row):
	1) Exclusions: if any rule fires, the assertion is not in this group.
	   excludeByPolicy: comma-separated policy names; assertion is excluded if its UUID
	   appears in any named UUID policy list, or its text contains any phrase from a
	   named assertionTextPhrases policy.
	   excludeCategories: comma-separated keyword tokens; excluded if the assertion
	   keywords field, split on commas, contains any listed token.
	2) includeByPolicy: comma-separated policy names; included when the assertion UUID
	   appears in any named UUID policy, or matches any named categoryWithCentrePairs policy.
	3) includeStandaloneCategories: comma-separated tokens compared to assertion
	   keywords (comma-separated). Used for standalone keyword tagging (including the
	   default categories file-centric-validation, component-centric-validation,
	   release-type-validation with special handling in RVF).

	If none of the include paths apply, the assertion is not added to that group.

	Suggested attribute order on group for readability:
	name, excludeByPolicy, excludeCategories, includeByPolicy, includeStandaloneCategories
-->
<assertionGroupingStrategy version="1.0">
	<group name="file-centric-validation" includeStandaloneCategories="file-centric-validation" />
	<group name="component-centric-validation" includeStandaloneCategories="component-centric-validation" />
	<group name="release-type-validation" includeStandaloneCategories="release-type-validation" />
	<group name="common-edition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs" />
	<group name="common-refset" includeByPolicy="common-refsets" />
	<group name="InternationalEdition" excludeByPolicy="snomed-rt-identifier,stated-relationship,int-edition-exclude" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,mrcm,INT" />
	<group name="USEdition" excludeByPolicy="stated-relationship,us-edition-exclude" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,US" />
	<group name="AustralianEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,AU" />
	<group name="DutchEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,NL" />
	<group name="SpanishEdition" excludeByPolicy="stated-relationship,spanish-extension-exclude" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,ES" />
	<group name="DanishEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,DK" />
	<group name="SwedishEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,SE" />
	<group name="BelgianEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,BE" />
	<group name="NorwegianEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,NO" />
	<group name="SwissEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,CH" />
	<group name="FrenchEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,FR" />
	<group name="IrishEdition" excludeByPolicy="stated-relationship" includeStandaloneCategories="file-centric-validation,component-centric-validation,release-type-validation,mdrs,extension-only,IE" />
